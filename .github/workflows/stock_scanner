name: Automated VN Stock Quant Scanner

on:
  # Chạy tự động từ Thứ 2 đến Thứ 6 theo giờ Việt Nam (UTC+7):
  # - 04:20 UTC = 11:20 sáng giờ VN (Trước khi khép phiên sáng)
  # - 07:10 UTC = 14:10 chiều giờ VN (Trước phiên ATC 20 phút để kịp đi lệnh)
  # - 08:05 UTC = 15:05 chiều giờ VN (Tổng kết đóng cửa toàn thị trường)
  schedule:
    - cron: '20 4 * * 1-5'
    - cron: '10 7 * * 1-5'
    - cron: '5 8 * * 1-5'

  # Cho phép bấm nút chạy thủ công (Run workflow) bất cứ lúc nào trên giao diện GitHub
  workflow_dispatch:
    inputs:
      scan_mode:
        description: 'Chế độ quét (LIQUID_UNIVERSE hoặc ALL)'
        required: false
        default: 'LIQUID_UNIVERSE'

jobs:
  scan-market:
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - name: 1. Checkout mã nguồn từ Repository
        uses: actions/checkout@v4

      - name: 2. Cài đặt môi trường Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: 3. Cài đặt thư viện vnstock và các gói phụ thuộc
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: 4. Chạy bộ lọc cổ phiếu và bắn tín hiệu về Telegram
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          SCAN_MODE: ${{ github.event.inputs.scan_mode || 'LIQUID_UNIVERSE' }}
          VNSTOCK_SOURCE: 'VCI'
          API_DELAY_SECONDS: '0.35'
        run: |
          python vn_stock_scanner.py

      - name: 5. Lưu file CSV kết quả quét làm Artifact (Tùy chọn tải về)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: stock-scan-results-${{ github.run_number }}
          path: scan_results_latest.csv
          if-no-files-found: ignore
          retention-days: 14
